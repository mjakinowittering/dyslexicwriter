{
    "printWidth": 80,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "none",
    "useTabs": false,
    "plugins": [
        "prettier-plugin-svelte",
        "@ianvs/prettier-plugin-sort-imports",
        "prettier-plugin-tailwindcss"
    ],
    "overrides": [{ "files": "*.svelte", "options": { "parser": "svelte" } }],
    "importOrder": [
        "^./\\$(.*)$",
        "",
        "<BUILTIN_MODULES>",
        "",
        "<THIRD_PARTY_MODULES>",
        "",
        "\\$lib/components/(.*)$",
        "",
        "\\$lib/(.*)$",
        "",
        "^./(.*)$"
    ]
}
