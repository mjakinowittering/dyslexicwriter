{
    "name": "dyslexicwriter",
    "description": "A local-first, distraction-free markdown word processor with read-aloud, built for a dyslexic writer.",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Matthew Akino-Wittering",
        "url": "https://matthew.akinowittering.com/"
    },
    "homepage": "https://mjakinowittering.github.io/dyslexicwriter/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mjakinowittering/dyslexicwriter.git"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "test:unit": "vitest",
        "test": "npm run test:unit -- --run",
        "test:coverage": "vitest run --coverage",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.2.1",
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/geist": "^5.2.9",
        "@fontsource/opendyslexic": "^5.3.0",
        "@hugeicons/core-free-icons": "^4.2.3",
        "@hugeicons/svelte": "^1.1.4",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@inlang/paraglide-js": "^2.15.2",
        "@lucide/svelte": "^1.31.0",
        "@storybook/addon-a11y": "^10.4.2",
        "@storybook/addon-docs": "^10.4.2",
        "@storybook/addon-svelte-csf": "^5.1.2",
        "@storybook/addon-themes": "^10.4.2",
        "@storybook/addon-vitest": "^10.4.2",
        "@storybook/sveltekit": "^10.4.2",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.57.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.2",
        "@types/node": "^22",
        "@types/turndown": "^5.0.6",
        "@types/wicg-file-system-access": "^2023.10.7",
        "@vitest/browser-playwright": "^4.1.3",
        "@vitest/coverage-v8": "^4.1.3",
        "bits-ui": "^2.18.1",
        "clsx": "^2.1.1",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-storybook": "^10.4.2",
        "eslint-plugin-svelte": "^3.17.0",
        "eslint-plugin-tailwindcss": "^4.3.0-svelte.beta.0",
        "globals": "^17.4.0",
        "playwright": "^1.60.0",
        "prettier-plugin-svelte": "^3.5.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "shadcn-svelte": "^1.3.0",
        "storybook": "^10.4.2",
        "svelte": "^5.55.2",
        "svelte-check": "^4.4.6",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.2.2",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.1",
        "vite": "^8.0.7",
        "vitest": "^4.1.3",
        "vitest-browser-svelte": "^2.1.0"
    },
    "dependencies": {
        "@tiptap/core": "^3.27.1",
        "@tiptap/extension-image": "3.27.1",
        "@tiptap/extension-table": "3.27.1",
        "@tiptap/extensions": "^3.27.1",
        "@tiptap/html": "^3.27.1",
        "@tiptap/starter-kit": "^3.27.1",
        "date-fns": "^4.4.0",
        "dexie": "^4.4.3",
        "js-yaml": "^5.3.0",
        "marked": "^18.0.9",
        "mode-watcher": "^1.1.0",
        "prettier": "^3.8.1",
        "turndown": "^7.2.4",
        "turndown-plugin-gfm": "^1.0.2",
        "valibot": "^1.4.1"
    }
}
